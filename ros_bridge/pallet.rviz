Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 26; 34; 40
    Fixed Frame: pallet
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.1
      Plane: XY
      Color: 75; 90; 100
    - Class: rviz_default_plugins/MarkerArray
      Name: Simulated brick placements
      Enabled: true
      Topic:
        Value: /munich_demo/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.4
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 0.24
        Y: 0.06
        Z: 0.07
Window Geometry:
  Width: 1200
  Height: 800
